# ============================================================================
#  secret.properties.example  —  TEMPLATE (được commit lên git, KHÔNG chứa key thật)
# ----------------------------------------------------------------------------
#  CÁCH DÙNG (mỗi người tự làm sau khi clone/pull code về):
#    1) Copy file này thành  secret.properties  (bỏ đuôi .example), đặt cạnh nó (trong grader/).
#         PowerShell:  Copy-Item grader/secret.properties.example grader/secret.properties
#    2) Mở grader/secret.properties, dán API KEY của BẠN vào.
#    3) Khởi động lại backend (cd grader && .\mvnw spring-boot:run).
#
#  secret.properties đã được .gitignore nên KHÔNG bao giờ bị commit/lộ lên GitHub.
#  Giá trị ở đây ĐÈ application.properties (nạp qua spring.config.import).
# ============================================================================

# Chọn nhà cung cấp: openai (GPT) | gemini (Google)
grader.ai.provider=openai

# ↓↓↓ DÁN KEY THẬT VÀO secret.properties (KHÔNG phải file .example này) ↓↓↓
grader.ai.openai.api-key=sk-REPLACE_WITH_YOUR_OPENAI_KEY
#grader.ai.openai.model=gpt-4o-mini

# Nếu dùng Gemini thay vì GPT:
#grader.ai.provider=gemini
#grader.ai.gemini.api-key=REPLACE_WITH_YOUR_GEMINI_KEY
