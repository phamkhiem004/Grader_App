# Copy file này thành .env nếu muốn chạy feedback-bot thủ công.
# Nếu chạy bằng .\run hoặc start-all.ps1, file feedback-bot/.env sẽ được sinh tự động.

# ollama = chạy local; openai = dùng API key bên dưới
FEEDBACK_PROVIDER=ollama

# Ollama local
FEEDBACK_MODEL_NAME=qwen3:14b
EMBED_MODEL_NAME=bge-m3
OLLAMA_TIMEOUT_SECONDS=600

# OpenAI mode, chỉ dùng khi FEEDBACK_PROVIDER=openai.
# Không dán key thật vào file .example.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
